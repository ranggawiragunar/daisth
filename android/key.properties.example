# Copy to android/key.properties and replace each placeholder with your upload-key values.
# Keep android/key.properties and the keystore private; never commit either file.
storePassword=REPLACE_WITH_UPLOAD_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_UPLOAD_KEY_PASSWORD
keyAlias=REPLACE_WITH_UPLOAD_KEY_ALIAS
storeFile=app/upload-keystore.jks
